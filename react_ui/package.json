{
  "name": "logiqore-reporter",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "author": "LogiQore",
  "license": "MIT",
  "description": "LogiQore Reporter - Geological QAQC Analysis Platform",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "type-check": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "coverage:ratchet": "node scripts/check-coverage-ratchet.mjs",
    "coverage:ratchet:ci": "node scripts/check-coverage-ratchet.mjs --warn-only",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "electron:dev": "node electron/dev-runner.cjs",
    "electron:build": "npm run build && electron-builder --config electron-builder.config.cjs",
    "electron:build:win": "npm run build && electron-builder --config electron-builder.config.cjs --win",
    "electron:build:mac": "npm run build && electron-builder --config electron-builder.config.cjs --mac",
    "electron:build:linux": "npm run build && electron-builder --config electron-builder.config.cjs --linux",
    "electron:start": "electron ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "ag-grid-community": "^34.3.1",
    "ag-grid-react": "^34.3.1",
    "buffer": "^6.0.3",
    "clsx": "^2.1.1",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "jspdf": "^4.1.0",
    "lucide-react": "^0.554.0",
    "papaparse": "^5.5.3",
    "plotly.js": "^3.3.1",
    "plotly.js-basic-dist-min": "^3.3.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-dropzone": "^14.3.8",
    "react-plotly.js": "^2.6.0",
    "recharts": "^3.4.1",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/file-saver": "^2.0.7",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.10.0",
    "@types/papaparse": "^5.3.16",
    "@types/plotly.js": "^3.0.9",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-plotly.js": "^2.6.4",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^3.1.3",
    "@vitest/ui": "^3.1.3",
    "autoprefixer": "^10.4.22",
    "baseline-browser-mapping": "^2.9.19",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jest-axe": "^10.0.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2",
    "vitest": "^3.1.3"
  }
}
